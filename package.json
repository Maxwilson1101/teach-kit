{
  "name": "teach-kit",
  "description": "Markdown-driven local course previews for teaching agents.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "teach-kit": "./dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run build && bun src/server/dev.ts",
    "start": "NODE_ENV=production bun src/server/dev.ts",
    "build": "bun run build.ts",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write",
    "verify": "bun run lint && bun run typecheck && bun run coverage:core && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test ./tests/unit ./tests/integration",
    "test:coverage": "bun run build && bun test ./tests/unit ./tests/integration --coverage",
    "coverage:core": "bun run build && bun run scripts/core-coverage.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast-util-definitions": "^6.0.0",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19",
    "react-dom": "^19",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/bun": "latest",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2"
  }
}
