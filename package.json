{
  "name": "teach-kit",
  "description": "Markdown-driven local course previews for teaching agents.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "bun --hot src/server/dev.ts",
    "start": "NODE_ENV=production bun src/server/dev.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2"
  }
}
